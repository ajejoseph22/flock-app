# Flock configuration. Copy to `.env` for local development (never commit `.env`).
# In production set these as Railway service variables; never put real values in the repo.

# development | test | production. Provider overrides below are ignored in production.
FLOCK_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres@127.0.0.1:5432/flock
LOG_LEVEL=info

# ── Telegram (from @BotFather) ──────────────────────────────────────────────
# Use a separate bot for development and production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random 32-256 chars [A-Za-z0-9_-]; e.g. `openssl rand -hex 32`. Telegram echoes it in a header on every webhook.
TELEGRAM_WEBHOOK_SECRET=
# webhook (deployed) | polling (local dev: the worker long-polls, no public URL needed)
TELEGRAM_MODE=polling
# Local mocks only (ignored in production):
# TELEGRAM_API_ROOT=http://127.0.0.1:4101

# ── Stripe (platform account; Connect enabled) ──────────────────────────────
# Test mode key in development (sk_test_… or a restricted rk_test_… key).
STRIPE_SECRET_KEY=
# Signing secrets for the three webhook destinations (see README → Stripe setup):
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PLATFORM_WEBHOOK_SECRET=
STRIPE_ACCOUNTS_WEBHOOK_SECRET=
# Local mocks only (ignored in production):
# STRIPE_API_HOST=127.0.0.1
# STRIPE_API_PORT=4102
# STRIPE_API_PROTOCOL=http

# ── Flock's own SaaS billing (off during early access) ──────────────────────
PLATFORM_BILLING_ENABLED=false
# STRIPE_PRICE_STARTER=price_…
# STRIPE_PRICE_GROWTH=price_…

# ── Access policy ───────────────────────────────────────────────────────────
RENEWAL_GRACE_HOURS=48
INVITE_LINK_TTL_HOURS=168

# ── Operations ──────────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@useflock.com
# Comma-separated Telegram user IDs allowed to open /admin
ADMIN_TELEGRAM_USER_IDS=
WORKER_CONCURRENCY=4
# Local demo data owner (see `pnpm db:seed`)
# SEED_OWNER_TELEGRAM_USER_ID=
